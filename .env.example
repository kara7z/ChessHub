# Copy to .env. Supply distinct local-only passwords before starting Compose.
POSTGRES_PASSWORD=
CHESSHUB_DB_PASSWORD=

CHESSHUB_DB_NAME=chesshub
CHESSHUB_DB_USER=chesshub_app
CHESSHUB_DB_PORT=5432
CHESSHUB_API_PORT=8080
CHESSHUB_WEB_PORT=5173

# Target for Vite running on the host; Compose wires this automatically.
API_PROXY_TARGET=http://127.0.0.1:8080
